--- a/src/wsi/sdl3/wsi_window_sdl2.cpp
+++ b/src/wsi/sdl3/wsi_window_sdl2.cpp
@@ -10,6 +10,26 @@
 
 namespace dxvk::wsi {
 
+#if defined(__APPLE__)
+  // AppKit windows may only be changed on the main thread, and SDL's Cocoa backend does not
+  // hop there itself. DXGI calls these from whichever thread owns the swap chain (on Apple the
+  // game's worker thread, while the main thread pumps SDL events), so send them over.
+  // SDL_RunOnMainThread runs the call inline when this already is the main thread.
+  template<typename Fn>
+  static bool onMainThread(Fn&& fn) {
+    struct Call { Fn* fn; bool ok; } call = { &fn, false };
+    if (!SDL_RunOnMainThread([] (void* userdata) {
+          auto* c = static_cast<Call*>(userdata);
+          c->ok = (*c->fn)();
+        }, &call, true))
+      return false;
+    return call.ok;
+  }
+  #define DXVK_SDL_WINDOW_CALL(expr) onMainThread([&] { return bool(expr); })
+#else
+  #define DXVK_SDL_WINDOW_CALL(expr) bool(expr)
+#endif
+
