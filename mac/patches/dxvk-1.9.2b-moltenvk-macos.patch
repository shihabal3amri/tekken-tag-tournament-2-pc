diff --git a/src/dxvk/platform/dxvk_sdl3_exts.cpp b/src/dxvk/platform/dxvk_sdl3_exts.cpp
index adaeaecc..0132bdb4 100644
--- a/src/dxvk/platform/dxvk_sdl3_exts.cpp
+++ b/src/dxvk/platform/dxvk_sdl3_exts.cpp
@@ -13,6 +13,22 @@ namespace dxvk {
 
 
   DxvkNameSet DxvkPlatformExts::getInstanceExtensions() {
+#if defined(__APPLE__)
+    // macOS: no dummy window. Cocoa windows may only be made on the main thread,
+    // and the device is often created elsewhere. SDL's Cocoa backend returns a
+    // fixed list (VK_KHR_surface + VK_EXT_metal_surface) that needs no window;
+    // without SDL video (an offscreen device) the same two names are used.
+    DxvkNameSet appleNames;
+    if (SDL_WasInit(SDL_INIT_VIDEO)) {
+      uint32_t extensionCount = 0;
+      const char* const* extensionNames = SDL_Vulkan_GetInstanceExtensions(&extensionCount);
+      for (uint32_t i = 0; extensionNames && i < extensionCount; i++)
+        appleNames.add(extensionNames[i]);
+    }
+    appleNames.add("VK_KHR_surface");
+    appleNames.add("VK_EXT_metal_surface");
+    return appleNames;
+#endif
 #if !defined(__ANDROID__)
     // Desktop SDL may not have loaded Vulkan yet. Android already owns its
     // native window and cannot create a second hidden window here.
