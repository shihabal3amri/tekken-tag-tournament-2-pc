--- a/src/util/platform/util_env_linux.cpp
+++ b/src/util/platform/util_env_linux.cpp
@@ -4,15 +4,27 @@
 #include <filesystem>
 #include <unistd.h>
 #include <limits.h>
+#ifdef __APPLE__
+#include <mach-o/dyld.h>
+#endif
 
 namespace dxvk::env {
 
   std::string getExePath() {
     std::array<char, PATH_MAX> exePath = {};
 
-    size_t count = readlink("/proc/self/exe", exePath.data(), exePath.size());
+#ifdef __APPLE__
+    uint32_t size = exePath.size();
+    if (_NSGetExecutablePath(exePath.data(), &size) != 0)
+      return std::string();
+    return std::string(exePath.data());
+#else
+    ssize_t count = readlink("/proc/self/exe", exePath.data(), exePath.size());
+    if (count <= 0)
+      return std::string();
 
     return std::string(exePath.begin(), exePath.begin() + count);
+#endif
   }
   
   
diff --git a/src/wsi/sdl3/wsi_presenter_sdl2.cpp b/src/wsi/sdl3/wsi_presenter_sdl2.cpp
index 7a74522b..78f908b6 100644
--- a/src/wsi/sdl3/wsi_presenter_sdl2.cpp
+++ b/src/wsi/sdl3/wsi_presenter_sdl2.cpp
@@ -13,9 +13,30 @@ namespace dxvk::wsi {
           VkSurfaceKHR*       pSurface) {
     SDL_Window* window = fromHwnd(hWindow);
 
+#if defined(__APPLE__)
+    // SDL's Cocoa backend makes an NSView (Cocoa_Metal_CreateView: addSubview) without
+    // hopping to the main thread itself; AppKit views may only be touched there.
+    // SDL_RunOnMainThread runs inline when this already is the main thread.
+    struct Request {
+      SDL_Window*   window;
+      VkInstance    instance;
+      VkSurfaceKHR* surface;
+      bool          ok;
+    } request = { window, vki->instance(), pSurface, false };
+
+    bool dispatched = SDL_RunOnMainThread([] (void* userdata) {
+      auto* r = static_cast<Request*>(userdata);
+      r->ok = SDL_Vulkan_CreateSurface(r->window, r->instance, nullptr, r->surface);
+    }, &request, true);
+
+    return dispatched && request.ok
+         ? VK_SUCCESS
+         : VK_ERROR_OUT_OF_HOST_MEMORY;
+#else
     return SDL_Vulkan_CreateSurface(window, vki->instance(), nullptr, pSurface)
          ? VK_SUCCESS
          : VK_ERROR_OUT_OF_HOST_MEMORY;
+#endif
   }
 
 }
diff --git a/src/wsi/sdl3/wsi_window_sdl2.cpp b/src/wsi/sdl3/wsi_window_sdl2.cpp
